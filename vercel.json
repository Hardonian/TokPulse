{
  "version": 2,
  "framework": "vite",
  "installCommand": "npx pnpm@8 install",
  "buildCommand": "npx pnpm@8 build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] }
  ]
}
