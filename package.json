{
  "name": "tokpulse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "npx playwright install --with-deps",
    "ci:unit": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed",
    "format:check": "prettier --check .",
    "quality:check": "turbo run typecheck && turbo run lint && turbo run format:check && turbo run test",
    "quality:fix": "turbo run lint -- --fix && pnpm format",
    "pre-commit": "turbo run typecheck && turbo run lint && turbo run test",
    "prepare": "husky install || true",
    "obs:dev": "docker-compose -f ops/docker-compose.observability.yml up -d",
    "obs:lint": "node scripts/lint-observability.mjs",
    "api:openapi": "node scripts/generate-openapi.mjs",
    "docs:dev": "cd apps/docs && pnpm dev",
    "docs:build": "cd apps/docs && pnpm build",
    "docs:lint": "cd apps/docs && pnpm lint",
    "billing:dev": "node scripts/billing-dev.mjs",
    "rbac:dev": "node scripts/rbac-dev.mjs",
    "feeds:gen": "node scripts/feeds-gen.mjs",
    "cache:purge": "node scripts/cache-purge.mjs",
    "ops:replay": "node scripts/ops-replay.mjs",
    "ops:simulate:traffic": "node scripts/ops-simulate-traffic.mjs",
    "spin:up": "node scripts/spin-up.mjs",
    "spin:down": "node scripts/spin-down.mjs",
    "doctor": "node scripts/doctor.mjs",
    "contracts:check": "node scripts/contracts-check.mjs",
    "env:validate": "node scripts/env-validate.mjs",
    "deps:graph": "node scripts/deps-graph.mjs",
    "seed:all": "node scripts/seed-all.mjs",
    "e2e:full": "pnpm test && pnpm e2e",
    "obs:smoke": "node scripts/obs-smoke.mjs",
    "ops:drill": "node scripts/ops-drill.mjs",
    "ai:diagnose": "node --loader ts-node/esm ai/self_diagnose.ts",
    "ai:insights": "node ai/insights_agent.mjs",
    "ai:cost": "node --loader ts-node/esm ai/ai_autoscale.ts",
    "ai:privacy": "node --loader ts-node/esm ai/privacy_guard.ts",
    "ai:embeddings": "node scripts/generate-embeddings.mjs",
    "ai:embeddings:refresh": "node scripts/generate-embeddings.mjs refresh",
    "ai:onboard": "node scripts/onboard-ai.mjs",
    "ai:release-notes": "node scripts/release-notes-ai.mjs",
    "futurecheck": "node --loader ts-node/esm scripts/futurecheck.ts",
    "futurecheck:json": "node --loader ts-node/esm scripts/futurecheck.ts --json",
    "watchers:db": "node --loader ts-node/esm watchers/db_integrity.watcher.ts",
    "watchers:api": "node --loader ts-node/esm watchers/api_contract.watcher.ts",
    "watchers:ai": "node --loader ts-node/esm watchers/ai_performance.watcher.ts",
    "watchers:all": "pnpm watchers:db && pnpm watchers:api && pnpm watchers:ai",
    "lint:ai": "node --loader ts-node/esm ai/privacy_guard.ts"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{js,ts,tsx,md,json}": [
      "prettier --write"
    ]
  },
  "version": "2.2.0",
  "pnpm": {
    "overrides": {
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "next": ">=15.5.24",
      "js-yaml": ">=4.3.2",
      "smol-toml": ">=1.7.1",
      "baseline-browser-mapping": ">=2.11.0",
      "browserslist": ">=4.28.7",
      "liquidjs": ">=10.27.2",
      "qs": ">=6.16.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "cookie@<0.7.0": ">=0.7.0",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
      "glob@>=11.0.0 <11.1.0": ">=11.1.0",
      "@remix-run/router@<=1.23.1": ">=1.23.2",
      "semver@>=7.0.0 <7.5.2": ">=7.5.2",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "vite@<=6.4.1": ">=6.4.2",
      "simple-git@<3.32.0": ">=3.32.0",
      "simple-git@>=3.15.0 <3.32.3": ">=3.32.3",
      "simple-git@<3.36.0": ">=3.36.0",
      "@tootallnate/once@<2.0.1": ">=2.0.1",
      "uuid@<11.1.1": ">=11.1.1",
      "turbo-stream@<3.0.0": ">=3.0.0",
      "@opentelemetry/sdk-node@<0.217.0": ">=0.217.0",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "@remix-run/server-runtime@<=2.17.2": ">=2.17.3",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vite@<=6.4.2": ">=6.4.3",
      "markdown-it@<=14.1.1": ">=14.2.0",
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0",
      "react-router@>=6.0.0 <7.18.0": ">=7.18.0",
      "react-router@>=6.4.0 <7.18.0": ">=7.18.0",
      "@remix-run/router@>=1.3.0 <1.23.3": ">=1.23.3",
      "vitest@<3.2.6": ">=3.2.6",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "react-router-dom@>=6.30.2 <=6.30.5": ">=6.30.6"
    }
  }
}
